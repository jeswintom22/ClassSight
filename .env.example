# Environment Variables for ClassSight

# ==================== SECURITY WARNING ====================
# NEVER commit the actual .env file to version control!
# Copy this file to .env and fill in your actual values.
# =========================================================

# ==================== API Keys ====================
# AI API Key for any OpenAI-compatible provider.
# Get keys from e.g. https://console.x.ai, https://platform.openai.com, https://console.groq.com
AI_API_KEY=your-api-key-here

# ==================== Server Configuration ====================
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ==================== Security Settings ====================

# CORS (Cross-Origin Resource Sharing)
# For development: Allow localhost
# For production: Set to your specific domain(s), comma-separated
# Example: CORS_ORIGINS=https://classsight.com,https://app.classsight.com
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000

# Allow all origins (ONLY for development, set to False in production!)
CORS_ALLOW_ALL=True

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_HEALTH=60/minute
RATE_LIMIT_ANALYSIS=10/minute
RATE_LIMIT_DEFAULT=30/minute

# File Upload
MAX_UPLOAD_SIZE=10485760    # 10 MB in bytes

# Input Validation
MAX_TEXT_LENGTH=50000

# ==================== OCR Settings ====================
OCR_LANGUAGE=en
OCR_GPU=False

# ==================== Frame Processing ====================
FRAME_CAPTURE_INTERVAL=3

# ==================== AI Settings (any OpenAI-compatible provider) ====================
# Base URL of the OpenAI-compatible /chat/completions endpoint:
#   OpenAI:     https://api.openai.com/v1
#   xAI Grok:   https://api.x.ai/v1
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   DeepSeek:   https://api.deepseek.com/v1
#   Together:   https://api.together.xyz/v1
AI_BASE_URL=https://api.x.ai/v1

# Model name (required - no default). Examples: grok-3, gpt-4o-mini, llama-3.3-70b-versatile
AI_MODEL=grok-3

# Optional: force the provider id instead of auto-detecting from AI_BASE_URL.
# Valid: openai | xai | groq | openrouter | deepseek | together | mistral | custom
# AI_PROVIDER=

AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7
AI_RETRIES=2
